# =============================================================
# SnapFocus — Production env vars TEMPLATE (sanitized, committed)
# Copy to `.env.production.template`, fill values, paste into Vercel.
# The real `.env.production.template` lives locally only — it's in
# .gitignore because it contains live keys.
# =============================================================

# ─────────────────────────────────────────────────────────────
# Supabase — Dashboard → Project Settings → API
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — webhook credit grants & cron purges.
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────
# AI (Anthropic primary; OpenAI optional)
# ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ─────────────────────────────────────────────────────────────
# App config
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://snap-focus.vercel.app
BILLING_PROVIDER=stripe

# ─────────────────────────────────────────────────────────────
# Stripe — dashboard.stripe.com
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Generated AFTER you create the webhook endpoint in Stripe dashboard.
# Endpoint URL: https://snap-focus.vercel.app/api/stripe/webhook
# Events: checkout.session.completed, customer.subscription.updated,
#         customer.subscription.deleted, invoice.payment_succeeded
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs — populated by `node scripts/setup-stripe.mjs`
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ULTIMATE=
STRIPE_PRICE_QUICK_FIX=
STRIPE_PRICE_VALUE_PACK=
STRIPE_PRICE_POWER_PACK=
