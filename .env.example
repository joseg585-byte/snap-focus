# =============================================================
# SnapFocus — environment template. Copy to .env.local and fill in.
# The scaffold compiles and renders the landing page WITHOUT any of these;
# they activate auth, billing, and AI generation.
# =============================================================

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Bypasses RLS — used by webhook credit grants & cron purges. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Billing (Stripe today; swappable for Apple IAP / RevenueCat later) ----
BILLING_PROVIDER=stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Stripe Price IDs per tier / top-up pack
STRIPE_PRICE_STARTER=price_xxx
STRIPE_PRICE_PRO=price_xxx
STRIPE_PRICE_ULTIMATE=price_xxx
STRIPE_PRICE_QUICK_FIX=price_xxx
STRIPE_PRICE_VALUE_PACK=price_xxx
STRIPE_PRICE_POWER_PACK=price_xxx

# ---- AI (Vercel AI SDK → OpenAI / Anthropic) ----
ANTHROPIC_API_KEY=sk-ant-xxx
OPENAI_API_KEY=sk-xxx
# Override the model ids resolved in src/lib/ai/index.ts
AI_BUDGET_MODEL=claude-haiku-4-5-20251001
AI_FLAGSHIP_MODEL=claude-opus-4-8

# ---- App ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Secret guarding the image-purge / retention cron endpoints
CRON_SECRET=change-me
